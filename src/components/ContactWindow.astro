---
import { site, socials } from '../data/site';
import { icons } from '../data/icons';

const options = [
  site.bookingUrl && { href: site.bookingUrl, tile: 'call', svg: icons.calendar(19), title: 'Book a call', sub: '15 minutes, no pressure', ext: true },
  { href: `mailto:${site.email}?subject=${encodeURIComponent('Editing project')}`, tile: 'mail', svg: icons.mail(19), title: 'Email me', sub: site.email, ext: false },
  { href: socials.instagramDm, tile: 'ig', svg: icons.instagram(19), title: 'DM me on Instagram', sub: `@${site.handle}`, ext: true },
  { href: socials.x, tile: 'x', svg: icons.x(16), title: 'DM me on X', sub: `@${site.handle}`, ext: true },
].filter(Boolean) as { href: string; tile: string; svg: string; title: string; sub: string; ext: boolean }[];
---
<dialog class="contact" id="contact-window" aria-labelledby="contact-title">
  <div class="window contact__win" data-win>
    <div class="window__bar">
      <div class="lights lights--color">
        <button type="button" data-close aria-label="Close" set:html={icons.close(7)} />
        <button type="button" data-close aria-label="Close" set:html={`<svg viewBox="0 0 16 16" width="7" height="7" aria-hidden="true"><path d="M3 8h10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>`} />
        <span aria-hidden="true"></span>
      </div>
      <span class="window__title">New message</span>
      <span></span>
    </div>

    <div class="contact__body">
      <p class="contact__eyebrow"><span class="pill__dot" aria-hidden="true"></span>Open to new projects</p>
      <h2 class="contact__title" id="contact-title">Let's talk about your next video</h2>
      <p class="contact__sub">Pick whatever's easiest. I reply within 24 hours.</p>

      <ul class="contact__opts">
        {options.map((o) => (
          <li data-opt>
            <a class="opt" href={o.href} target={o.ext ? '_blank' : undefined} rel={o.ext ? 'noopener' : undefined}>
              <span class={`opt__tile opt__tile--${o.tile}`} aria-hidden="true" set:html={o.svg} />
              <span class="opt__text"><b>{o.title}</b><small>{o.sub}</small></span>
              <span class="opt__arrow" aria-hidden="true" set:html={icons.arrow(15)} />
            </a>
          </li>
        ))}
      </ul>

      <button class="copy" type="button" data-copy={site.email} data-opt>
        <span class="copy__icon" aria-hidden="true" set:html={icons.copy(14)} />
        <span class="copy__text">Copy email address</span>
        <span class="copy__state" aria-live="polite"></span>
      </button>
    </div>
  </div>
</dialog>

<style is:global>
  .contact { margin: auto; width: min(480px, calc(100% - 28px)); }
  .contact::backdrop {
    background: rgba(40, 28, 90, .12);
    -webkit-backdrop-filter: blur(5px) saturate(1.1);
    backdrop-filter: blur(5px) saturate(1.1);
    opacity: 0; transition: opacity .34s ease-in;
  }
  .contact.is-open::backdrop { opacity: 1; transition: opacity .6s var(--ease); }

  /* liquid glass: milky translucent body, bright rim, soft specular highlight */
  .contact__win {
    position: relative; overflow: hidden;
    background: linear-gradient(160deg, rgba(255,255,255,.66), rgba(248,246,255,.42));
    border: 1px solid rgba(255,255,255,.75);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.95),
      inset 0 -1px 0 rgba(255,255,255,.35),
      inset 0 0 30px rgba(255,255,255,.35),
      0 50px 120px -20px rgba(40,20,120,.35),
      0 10px 30px rgba(18,17,22,.08);
    -webkit-backdrop-filter: blur(36px) saturate(1.9);
    backdrop-filter: blur(36px) saturate(1.9);
  }
  .contact__win::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
    background:
      radial-gradient(120% 60% at 15% -10%, rgba(255,255,255,.75), transparent 55%),
      radial-gradient(80% 50% at 100% 110%, rgba(190,170,255,.25), transparent 60%);
  }
  .contact__win > * { position: relative; }
  .contact__body { padding: 12px 26px 24px; }
  .contact__eyebrow {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 6px 13px 6px 11px; border-radius: var(--r-pill);
    background: rgba(255,255,255,.6); border: 1px solid rgba(255,255,255,.8);
    font-size: .8rem; font-weight: 520; color: var(--ink-2);
  }
  .contact__title { margin-top: 16px; font-size: clamp(1.6rem, 1.3rem + 1vw, 2rem); line-height: 1.08; letter-spacing: -0.035em; }
  .contact__sub { margin-top: 10px; color: var(--ink-3); font-size: .95rem; }
  .contact__opts { display: flex; flex-direction: column; gap: 8px; margin-top: 24px; }

  .opt {
    display: flex; align-items: center; gap: 14px;
    min-height: 68px; padding: 12px 16px 12px 12px;
    border-radius: 18px;
    background: rgba(255,255,255,.5);
    border: 1px solid rgba(255,255,255,.7);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.8);
    transition: background-color var(--t) var(--ease), border-color var(--t) var(--ease), transform var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  @media (hover: hover) { .opt:hover { background: rgba(255,255,255,.85); border-color: rgba(185,169,255,.8); transform: translateY(-2px); box-shadow: inset 0 1px 0 #fff, 0 14px 30px -14px rgba(60,30,180,.35); } }
  .opt:active { transform: scale(.985); }
  .opt__tile {
    flex: none; display: grid; place-items: center;
    width: 44px; height: 44px; border-radius: 13px; color: #fff;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.25), 0 4px 12px -4px rgba(0,0,0,.25);
  }
  .opt__tile--mail, .opt__tile--call { background: linear-gradient(160deg, #8467FF, #5B3BF2); }
  .opt__tile--ig { background: radial-gradient(circle at 30% 107%, #FDF497 0%, #FDF497 5%, #FD5949 45%, #D6249F 60%, #285AEB 90%); }
  .opt__tile--x { background: #0F0F12; }
  .opt__text b { display: block; font-weight: 620; letter-spacing: -0.015em; }
  .opt__text small { display: block; color: var(--ink-3); font-size: .84rem; }
  .opt__arrow { margin-left: auto; color: var(--ink-3); transition: transform .6s var(--ease), color var(--t) var(--ease); }
  @media (hover: hover) { .opt:hover .opt__arrow { transform: translateX(4px); color: var(--accent); } }

  .copy {
    display: flex; align-items: center; gap: 10px; width: 100%;
    margin-top: 12px; padding: 12px 14px; border-radius: 14px;
    font-size: .9rem; color: var(--ink-2);
    transition: background-color var(--t) var(--ease), color var(--t) var(--ease);
  }
  @media (hover: hover) { .copy:hover { background: rgba(255,255,255,.55); color: var(--ink); } }
  .copy__state { margin-left: auto; font-size: .8rem; font-weight: 600; color: var(--ok); }
</style>
