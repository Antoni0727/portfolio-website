---
import { Image } from 'astro:assets';
import Label from './Label.astro';
import { icons } from '../data/icons';
import { longForm, thumb } from '../data/work';
import resolveLogo from '../assets/logos/resolve.png';
import affinityLogo from '../assets/logos/affinity.svg';
import epidemicLogo from '../assets/logos/epidemic.svg';

const pub = longForm[0];
const pubThumb = pub.thumb ?? thumb.mid(pub.id);
---
<section class="section" id="process" aria-labelledby="process-title">
  <div class="container">
    <div class="head-center">
      <Label>Process</Label>
      <h2 class="h2" id="process-title" data-split>From raw footage to <span class="sel" data-sel>upload</span></h2>
      <p class="lead" data-reveal>You focus on creating and selling. I take it from raw clips to a video that's ready to post.</p>
    </div>

    <ol class="steps">
      <!-- 01 -->
      <li class="step" data-reveal data-step="drop">
        <div class="step__art" aria-hidden="true">
          <div class="drop">
            <span class="drop__file" data-file>A-cam.mov</span>
            <span class="drop__file" data-file>B-roll.mp4</span>
            <span class="drop__file" data-file>voice.wav</span>
            <div class="drop__folder">
              <span class="drop__tab"></span>
              <span class="drop__body">
                <span class="drop__name"><i set:html={icons.drive(13)} />Your channel × Tony</span>
                <span class="drop__count num" data-count>0 files</span>
                <span class="drop__bar"><i data-bar></i></span>
              </span>
            </div>
          </div>
        </div>
        <span class="step__num num">01</span>
        <h3 class="step__title">Send your footage</h3>
        <p class="step__text">Upload your raw clips to a shared Google Drive space I set up for you. Everything stays organized in one place.</p>
      </li>

      <!-- 02 -->
      <li class="step" data-reveal data-step="story">
        <div class="step__art" aria-hidden="true">
          <div class="board">
            <div class="board__row">
              {[['Hook', 'face'], ['Setup', 'text'], ['Value', 'screen'], ['Offer', 'face']].map(([label, kind], i) => (
                <figure class="board__frame" data-frame>
                  <span class="board__shot" data-kind={kind}>
                    {kind === 'face' && <><i class="board__head"></i><i class="board__body"></i></>}
                    {kind === 'text' && <><i class="board__line"></i><i class="board__line board__line--s"></i></>}
                    {kind === 'screen' && <><i class="board__ui"></i><i class="board__ui board__ui--b"></i></>}
                  </span>
                  <figcaption><b class="num">{String(i + 1).padStart(2, '0')}</b>{label}</figcaption>
                </figure>
              ))}
              <svg class="board__link" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path data-link d="M6 5 H94" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2 2.5" vector-effect="non-scaling-stroke"/></svg>
            </div>
            <span class="board__msg" data-msg-plan><i data-msg-icon></i><span data-msg-text>Plan sent to you</span></span>
          </div>
        </div>
        <span class="step__num num">02</span>
        <h3 class="step__title">Plan, story &amp; pacing</h3>
        <p class="step__text">First I storyboard the video and run the plan by you. Then I pick the best takes, cut what drags and set the rhythm, so it flows from the first second to your offer.</p>
      </li>

      <!-- 03 -->
      <li class="step" data-reveal data-step="polish">
        <div class="step__art" aria-hidden="true">
          <div class="polish">
            <div class="polish__ui">
              <div class="polish__viewer">
                <span class="polish__grade" data-grade></span>
                <span class="polish__cap" data-cap>keeps them watching</span>
              </div>
              <div class="polish__tl" data-lane>
                <div class="polish__row polish__row--t"><i data-t1></i><i data-t2></i></div>
                <div class="polish__row polish__row--v"><i></i><i></i><i></i><i></i></div>
                <div class="polish__row polish__row--a">{Array.from({ length: 34 }).map(() => <b data-eq></b>)}</div>
                <div class="polish__row polish__row--m"><i data-m1></i><i data-m2></i></div>
                <span class="polish__head" data-sweep></span>
              </div>
            </div>
            <div class="tools">
              <span class="tool" title="DaVinci Resolve"><Image src={resolveLogo} alt="" width={96} height={96} /></span>
              <span class="tool" title="Affinity"><img src={affinityLogo.src} alt="" width="44" height="44" /></span>
              <span class="tool tool--figma" title="Figma"><i set:html={icons.figma(26)} /></span>
              <span class="tool tool--epidemic" title="Epidemic Sound"><img src={epidemicLogo.src} alt="" width="22" height="26" /></span>
            </div>
          </div>
        </div>
        <span class="step__num num">03</span>
        <h3 class="step__title">Sound, motion &amp; color</h3>
        <p class="step__text">Sound design and music, motion graphics, captions and color in DaVinci Resolve, with design work in Affinity and Figma and tracks from Epidemic Sound.</p>
      </li>

      <!-- 04 -->
      <li class="step" data-reveal data-step="publish">
        <div class="step__art" aria-hidden="true">
          <div class="up">
            <div class="up__win">
              <div class="up__bar"><span class="lights"><span></span><span></span><span></span></span><span>Upload video</span><span></span></div>
              <div class="up__body">
                <img class="up__thumb" src={pubThumb} alt="" width="320" height="180" loading="lazy" draggable="false" />
                <div class="up__info">
                  <b>final_v2.mp4</b>
                  <span class="up__status num" data-status>Uploading… 0%</span>
                  <span class="up__progress"><i data-progress></i></span>
                </div>
              </div>
              <div class="up__foot"><span class="up__btn" data-btn><span data-btn-label>Publish</span></span></div>
            </div>
            <span class="up__cursor" data-cursor-arrow><svg viewBox="0 0 24 24" width="22" height="22"><path d="M5 3l14 8-6 1.6L10 19z" fill="#121116" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/></svg></span>
          </div>
        </div>
        <span class="step__num num">04</span>
        <h3 class="step__title">Ready to upload</h3>
        <p class="step__text">The final video lands in your Drive, ready to post. Need Shorts cut from it too? I'll do those as well.</p>
      </li>
    </ol>
  </div>
</section>

<style>
  .head-center { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: clamp(36px, 5vw, 60px); }
  .head-center .lead { margin-top: 20px; }

  .steps { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(16px, 2vw, 24px); }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; } }

  .step {
    position: relative; padding: 12px 12px 30px;
    border-radius: 30px; background: var(--surface);
    border: 1px solid var(--line); box-shadow: var(--shadow-1);
    transition: transform .8s var(--ease), border-color .8s var(--ease);
  }
  /* hover shadow lives on its own layer and only fades (no per-frame shadow repaint) */
  .step::after { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit; box-shadow: 0 30px 70px -30px rgba(40,20,120,.32); opacity: 0; transition: opacity .8s var(--ease); pointer-events: none; }
  .step { isolation: isolate; }
  @media (hover: hover) { .step:hover { transform: translateY(-6px); border-color: var(--accent-100); } .step:hover::after { opacity: 1; } }
  .step__art {
    position: relative; height: 240px; overflow: hidden; margin-bottom: 24px;
    border-radius: 22px; border: 1px solid var(--line);
    background:
      radial-gradient(90% 80% at 50% 0%, rgba(107,75,255,.07), transparent 65%),
      radial-gradient(circle at 1px 1px, rgba(18,17,22,.07) 1px, transparent 1.5px) 0 0 / 18px 18px,
      var(--bg);
  }
  .step__num { display: block; padding-inline: 14px; font-size: .82rem; font-weight: 600; color: var(--accent-700); }
  .step__title { padding-inline: 14px; margin-top: 6px; font-size: 1.4rem; letter-spacing: -0.03em; font-weight: 640; }
  .step__text { padding-inline: 14px; margin-top: 8px; color: var(--ink-3); max-width: 32em; }

  .drop__file {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--surface); border: 1px solid var(--line); box-shadow: 0 6px 16px -8px rgba(18,17,22,.2);
    font-size: .76rem; font-weight: 560; color: var(--ink-2); white-space: nowrap;
  }

  /* 01 drop */
  .drop { position: absolute; inset: 0; }
  .drop__file { position: absolute; top: 24px; left: 50%; padding: 7px 11px; border-radius: 10px; opacity: 0; }
  .drop__folder { position: absolute; left: 50%; bottom: 26px; width: 236px; height: 124px; transform: translateX(-50%); }
  .drop__tab { position: absolute; left: 0; top: 0; width: 92px; height: 24px; border-radius: 11px 11px 0 0; background: #CFC3FF; }
  .drop__body {
    position: absolute; inset: 14px 0 0 0; padding: 16px;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 8px;
    border-radius: 6px 18px 18px 18px;
    background: linear-gradient(180deg, #EFEAFF, #E1D8FF);
    box-shadow: 0 16px 34px -12px rgba(107,75,255,.35), inset 0 1px 0 rgba(255,255,255,.8);
  }
  .drop__name { display: flex; align-items: center; gap: 7px; font-size: .8rem; font-weight: 620; color: #3E28B0; }
  .drop__name i { display: inline-grid; color: #6B4BFF; }
  .drop__count { font-size: .72rem; font-weight: 500; color: #6550c8; }
  .drop__bar { height: 6px; border-radius: 6px; background: rgba(107,75,255,.16); overflow: hidden; }
  .drop__bar i { display: block; height: 100%; border-radius: inherit; background: var(--accent); transform-origin: left; transform: scaleX(0); }

  /* 02 storyboard */
  .board { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; padding: 0 20px; }
  .board__row { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; width: 100%; max-width: 440px; }
  .board__frame { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 7px; }
  .board__shot { position: relative; display: block; aspect-ratio: 16 / 11; border-radius: 9px; background: var(--surface); border: 1.5px solid rgba(18,17,22,.14); box-shadow: 0 6px 14px -8px rgba(18,17,22,.25); overflow: hidden; transition: transform .8s var(--ease); }
  .board__head { position: absolute; left: 50%; top: 22%; width: 26%; aspect-ratio: 1; transform: translateX(-50%); border-radius: 50%; border: 1.5px solid rgba(18,17,22,.45); }
  .board__body { position: absolute; left: 50%; bottom: -12%; width: 56%; height: 38%; transform: translateX(-50%); border-radius: 50% 50% 0 0; border: 1.5px solid rgba(18,17,22,.45); border-bottom: 0; }
  .board__line { position: absolute; left: 16%; right: 16%; top: 38%; height: 5px; border-radius: 4px; background: rgba(107,75,255,.55); }
  .board__line--s { top: 56%; right: 34%; background: rgba(18,17,22,.25); }
  .board__ui { position: absolute; left: 12%; right: 12%; top: 18%; height: 34%; border-radius: 4px; border: 1.5px solid rgba(18,17,22,.4); }
  .board__ui--b { top: 62%; height: 14%; right: 46%; background: rgba(107,75,255,.5); border: 0; }
  .board__frame figcaption { display: flex; gap: 5px; align-items: baseline; font-size: .74rem; font-weight: 600; color: var(--ink-2); }
  .board__frame figcaption b { font-size: .66rem; color: var(--accent-700); }
  .board__link { position: absolute; left: 0; right: 0; top: 34%; z-index: 0; width: 100%; height: 10px; color: var(--accent); overflow: visible; }
  .board__msg { display: inline-flex; align-items: center; gap: 8px; padding: 7px 13px 7px 9px; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line); box-shadow: 0 8px 18px -10px rgba(18,17,22,.3); font-size: .78rem; font-weight: 600; color: var(--ink-2); opacity: 0; }
  .board__msg i { width: 18px; height: 18px; border-radius: 50%; background: var(--accent); box-shadow: inset 0 0 0 4px #fff, 0 0 0 1px var(--accent-200); }
  .board__msg.is-approved { color: var(--ok); }
  .board__msg.is-approved i { background: var(--ok); box-shadow: none; }

  /* 03 polish: one centered group (editor + tool icons) */
  .polish { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px; padding: 0 22px; }
  .polish__ui { width: 100%; max-width: 420px; display: grid; grid-template-columns: 132px 1fr; gap: 10px; padding: 10px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-1); transition: transform .8s var(--ease); }
  .polish__viewer { position: relative; aspect-ratio: 16 / 10; align-self: center; border-radius: 9px; overflow: hidden; background: linear-gradient(160deg, #6D7280, #3D414B); }
  .polish__grade { position: absolute; inset: 0; background: linear-gradient(160deg, #F7A86B, #7B4BFF 70%, #2A1E5C); opacity: 0; }
  .polish__cap { position: absolute; left: 6px; right: 6px; bottom: 6px; padding: 3px 5px; border-radius: 5px; background: rgba(0,0,0,.6); color: #fff; font-size: .66rem; font-weight: 700; line-height: 1.2; text-align: center; opacity: 0; }
  .polish__tl { position: relative; display: grid; gap: 4px; padding: 2px 0; }
  .polish__row { position: relative; height: 12px; }
  .polish__row i { position: absolute; top: 0; bottom: 0; border-radius: 4px; }
  .polish__row--t i { background: linear-gradient(180deg, #A994FF, #8B72FF); }
  [data-t1] { left: 4%; width: 22%; } [data-t2] { left: 58%; width: 26%; }
  .polish__row--v { height: 18px; }
  .polish__row--v i { width: 24%; background: linear-gradient(180deg, #4B4A57, #2E2D38); }
  .polish__row--v i:nth-child(1) { left: 0; } .polish__row--v i:nth-child(2) { left: 25.3%; } .polish__row--v i:nth-child(3) { left: 50.6%; } .polish__row--v i:nth-child(4) { left: 75.9%; }
  .polish__row--a { display: flex; align-items: center; gap: 2px; height: 20px; padding: 0 3px; border-radius: 4px; background: #DCEFE4; }
  .polish__row--a b { flex: 1; height: 80%; border-radius: 2px; background: #3FAE73; transform: scaleY(.3); animation: eq .9s ease-in-out infinite alternate; animation-play-state: paused; }
  .polish__row--a b:nth-child(3n) { animation-duration: .7s; animation-delay: -.3s; }
  .polish__row--a b:nth-child(3n+1) { animation-duration: 1.1s; animation-delay: -.6s; }
  .polish__row--a b:nth-child(4n) { animation-duration: .6s; animation-delay: -.15s; }
  .polish__row--a b:nth-child(5n+2) { animation-duration: 1.3s; animation-delay: -.9s; }
  [data-step].is-live .polish__row--a b { animation-play-state: running; }
  @keyframes eq { from { transform: scaleY(.25); } to { transform: scaleY(1); } }
  .polish__row--m i { background: #C9D3F8; box-shadow: inset 0 0 0 1px rgba(80,100,200,.2); }
  [data-m1] { left: 0; width: 47%; } [data-m2] { left: 50%; width: 50%; }
  .polish__head { position: absolute; top: -2px; bottom: -2px; left: 0; width: 2px; border-radius: 2px; background: var(--accent); }
  .polish__head::before { content: ""; position: absolute; top: -4px; left: 50%; width: 8px; height: 8px; transform: translateX(-50%); border-radius: 50%; background: var(--accent); }
  .tools { display: flex; justify-content: center; gap: 12px; }
  .tool {
    display: grid; place-items: center; width: 50px; height: 50px; border-radius: 14px;
    background: var(--surface); border: 1px solid var(--line);
    box-shadow: 0 10px 22px -10px rgba(18,17,22,.35);
    transition: transform .8s var(--ease);
  }
  .tool :global(img) { width: 40px; height: 40px; border-radius: 10px; -webkit-user-drag: none; }
  .tool i { display: inline-grid; }
  .tool--epidemic { background: #0E0E10; border-color: transparent; }
  .tool--epidemic :global(img) { width: 22px; height: 26px; border-radius: 0; }

  /* hover: each illustration reacts a little */
  @media (hover: hover) {
    .step:hover .tool:nth-child(1) { transform: translateY(-6px) rotate(-6deg); }
    .step:hover .tool:nth-child(2) { transform: translateY(-9px) rotate(-2deg); transition-delay: .05s; }
    .step:hover .tool:nth-child(3) { transform: translateY(-9px) rotate(2deg); transition-delay: .1s; }
    .step:hover .tool:nth-child(4) { transform: translateY(-6px) rotate(6deg); transition-delay: .15s; }
    .step:hover .drop__folder { transform: translateX(-50%) translateY(-6px) rotate(-1.5deg); }
    .step:hover .board__frame:nth-child(odd) .board__shot { transform: translateY(-4px) rotate(-2deg); }
    .step:hover .board__frame:nth-child(even) .board__shot { transform: translateY(-4px) rotate(2deg); }
    .step:hover .up__win { transform: translateY(-6px) scale(1.02); }
    .step:hover .polish__ui { transform: translateY(-3px); }
  }
  .drop__folder, .up__win { transition: transform .8s var(--ease); }

  /* 04 upload dialog */
  .up { position: absolute; inset: 0; display: grid; place-items: center; }
  .up__win { width: min(86%, 330px); border-radius: 16px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-2); overflow: hidden; }
  .up__bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 30px; padding: 0 10px; font-size: .7rem; font-weight: 600; color: var(--ink-2); border-bottom: 1px solid var(--line); }
  .up__bar .lights { gap: 5px; }
  .up__bar .lights > * { width: 8px; height: 8px; }
  .up__body { display: grid; grid-template-columns: 112px 1fr; gap: 12px; align-items: center; padding: 12px; }
  .up__thumb { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; }
  .up__info { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .up__info b { font-size: .8rem; font-weight: 620; }
  .up__status { font-size: .7rem; color: var(--ink-3); }
  .up__progress { height: 5px; border-radius: 5px; background: var(--bg-2); overflow: hidden; margin-top: 2px; }
  .up__progress i { display: block; height: 100%; border-radius: inherit; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  .up__foot { display: flex; justify-content: flex-end; padding: 0 12px 12px; }
  .up__btn { position: relative; display: inline-flex; align-items: center; gap: 6px; padding: 7px 16px; border-radius: var(--r-pill); background: var(--accent); color: #fff; font-size: .75rem; font-weight: 650; box-shadow: 0 8px 18px -8px var(--accent-glow); }
  .up__cursor { position: absolute; left: 0; top: 0; z-index: 3; }
</style>
