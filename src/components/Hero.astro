---
import Button from './Button.astro';
import { longForm, thumb } from '../data/work';
import { icons } from '../data/icons';

/* Timeline is built from your first four long-form videos. Weights = relative clip length. */
const weights = [1.15, 0.9, 1.1, 0.85];
const picks = longForm.slice(0, 4);
const total = weights.slice(0, picks.length).reduce((a, b) => a + b, 0);
const GAP = 0.004;
let acc = 0;
const clips = picks.map((v, i) => {
  const start = acc / total;
  acc += weights[i];
  return { ...v, start, end: acc / total, src: v.thumb ?? thumb.max(v.id), strip: v.thumb ?? thumb.mid(v.id), zoom: v.zoom ?? 1 };
});
const titleBlocks = ['Hook', 'Title', 'Lower third', 'Call to action'];

/* Deterministic waveform bars (stable between builds) */
function wave(n: number, seed: number, floor = 0.14) {
  return Array.from({ length: n }, (_, i) => {
    const t = i / n;
    const env = Math.min(1, t * 6, (1 - t) * 6);              // fade at clip edges
    const v = 0.5 * Math.abs(Math.sin(t * (11 + seed) + seed)) + 0.32 * Math.abs(Math.sin(t * (41 + seed * 3))) + 0.22 * Math.abs(Math.sin(t * (97 + seed * 5) + 1.7));
    const pause = Math.sin(t * 19 + seed * 2) > 0.9 ? 0.15 : 1;  // little breaths between sentences
    return Math.max(floor, Math.min(1, (v / 1.05) * pause * (0.35 + 0.65 * env)));
  });
}
const bars = (vals: number[], w = 100, h = 20) =>
  vals.map((v, i) => `<rect x="${((i / vals.length) * w + 0.35).toFixed(2)}" y="${((h - v * h) / 2).toFixed(2)}" width="${(w / vals.length - 0.7).toFixed(2)}" height="${(v * h).toFixed(2)}" rx="0.4"/>`).join('');

/* Smooth filled waveform (for music) */
const envelope = (vals: number[], w = 100, h = 20) => {
  const step = w / (vals.length - 1);
  const top = vals.map((v, i) => `${(i * step).toFixed(2)},${((h - v * h) / 2).toFixed(2)}`);
  const bottom = vals.map((v, i) => `${(i * step).toFixed(2)},${((h + v * h) / 2).toFixed(2)}`).reverse();
  return `<path fill="#8DA0EC" d="M${top.join(' L')} L${bottom.join(' L')} Z"/>`;
};

const music = [
  { start: 0.0, end: 0.47 },
  { start: 0.5, end: 0.985 },
];
const sfx = [0.07, 0.24, 0.43, 0.61, 0.79, 0.9];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__aurora" aria-hidden="true">
    <span class="aura aura--1" data-aura></span>
    <span class="aura aura--2" data-aura></span>
  </div>

  <div class="container hero__inner">
    <p class="pill" data-hero-item><span class="pill__dot" aria-hidden="true"></span>Open to new projects</p>
    <h1 class="hero__title" id="hero-title" data-hero-title data-split>
      Edits that turn attention into <span class="sel" data-sel>growth</span>
    </h1>
    <div class="hero__actions" data-hero-item>
      <Button cta icon="arrow">Message me</Button>
      <Button variant="ghost" href="#work">See the work</Button>
    </div>
  </div>

  <div class="container hero__stage" data-hero-stage>
    <div class="editor window" data-editor data-hero-item>
      <div class="window__bar">
        <div class="lights" aria-hidden="true"><span></span><span></span><span></span></div>
        <span class="window__title" data-ed-title>{clips[0].title}</span>
        <span></span>
      </div>

      <div class="editor__viewer" data-ed-viewer data-glow>
        {clips.map((c, i) => (
          <img
            class:list={['editor__frame', i === 0 && 'is-active']}
            src={c.src}
            alt=""
            width="1280" height="720"
            draggable="false"
            decoding="async"
            style={`--zoom:${c.zoom}`}
            data-ed-frame={i}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        ))}
        <span class="vglow" aria-hidden="true"></span>
        <span class="editor__meta" data-ed-meta>{clips[0].meta.join(' · ')}</span>
        <button class="editor__stop" type="button" data-ed-stop aria-label="Stop video" set:html={icons.close(13)} />
      </div>

      <div class="transport" role="group" aria-label="Player controls">
        <span class="transport__count num" data-ed-count aria-live="polite">1 / {clips.length}</span>
        <div class="transport__btns">
          <button class="tbtn" type="button" data-ed-prev aria-label="Previous clip">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6.5 5v14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M18 5.8v12.4a.8.8 0 0 1-1.2.7L8.6 12.7a.8.8 0 0 1 0-1.4l8.2-6.2a.8.8 0 0 1 1.2.7z" fill="currentColor"/></svg>
          </button>
          <button class="tbtn tbtn--play" type="button" data-ed-play aria-label={`Play ${clips[0].title}`}>
            <svg class="tbtn__play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6.9 5.2v13.6a.8.8 0 0 0 1.2.7l10.6-6.8a.8.8 0 0 0 0-1.4L8.1 4.5A.8.8 0 0 0 6.9 5.2z" fill="currentColor"/></svg>
            <svg class="tbtn__pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1.2" fill="currentColor"/><rect x="13.5" y="5" width="4" height="14" rx="1.2" fill="currentColor"/></svg>
          </button>
          <button class="tbtn" type="button" data-ed-next aria-label="Next clip">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M17.5 5v14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M6 5.8v12.4a.8.8 0 0 0 1.2.7l8.2-6.2a.8.8 0 0 0 0-1.4L7.2 5.1A.8.8 0 0 0 6 5.8z" fill="currentColor"/></svg>
          </button>
        </div>
        <span class="transport__hint">Play the full video</span>
      </div>

      <div class="tl" data-tl>
        <div class="tl__area" data-tl-area>
          <div class="tl__ruler" aria-hidden="true">
            {['0:00', '0:15', '0:30', '0:45', '1:00'].map((t) => <span class="num">{t}</span>)}
          </div>

          <div class="tl__track tl__track--titles" aria-hidden="true">
            {clips.map((c, i) => (
              <span class="tl__title" style={`--s:${c.start + 0.01};--w:${(c.end - c.start) * 0.42}`}>{titleBlocks[i]}</span>
            ))}
          </div>

          <div class="tl__track tl__track--video">
            {clips.map((c, i) => (
              <button
                type="button"
                class="tl__clip"
                style={`--s:${c.start};--w:${c.end - c.start - GAP};--img:url(${c.strip});--zoom:${c.zoom}`}
                data-tl-clip={i}
                aria-label={`Show ${c.title}`}
              ><span>{c.meta[c.meta.length - 1]}</span></button>
            ))}
          </div>

          <div class="tl__track tl__track--dialog" aria-hidden="true">
            {clips.map((c, i) => (
              <span class="tl__audio" style={`--s:${c.start};--w:${c.end - c.start - GAP}`}>
                <svg viewBox="0 0 100 20" preserveAspectRatio="none" set:html={bars(wave(46, i + 1))} />
              </span>
            ))}
          </div>

          <div class="tl__track tl__track--music" aria-hidden="true">
            {music.map((m, i) => (
              <span class="tl__audio tl__audio--music" style={`--s:${m.start};--w:${m.end - m.start}`}>
                <svg viewBox="0 0 100 20" preserveAspectRatio="none" set:html={envelope(wave(80, i + 6, 0.3).map((v) => 0.4 + v * 0.5))} />
              </span>
            ))}
          </div>

          <div class="tl__track tl__track--sfx" aria-hidden="true">
            {sfx.map((s) => <span class="tl__sfx" style={`--s:${s}`}></span>)}
          </div>

          <div class="tl__ghost" data-tl-ghost aria-hidden="true"></div>
          <div class="tl__playhead" data-tl-head aria-hidden="true"><span></span></div>
        </div>
      </div>

      <script type="application/json" data-ed-clips set:html={JSON.stringify(clips.map(({ id, title, meta, start, end }) => ({ id, title, meta: meta.join(' · '), start, end })))} />
    </div>
    <p class="hero__hint" data-hero-item>Drag the playhead, pick a clip or press play</p>
  </div>
</section>

<style>
  .hero { position: relative; padding-top: clamp(150px, 20vh, 210px); padding-bottom: clamp(40px, 6vw, 80px); isolation: isolate; }

  .hero__aurora { position: absolute; inset: -10% 0 auto 0; height: 120vh; z-index: -1; pointer-events: none; overflow: hidden; }
  .aura { position: absolute; border-radius: 50%; will-change: transform; }
  .aura--1 { width: 70vmax; height: 50vmax; left: 50%; top: -14vmax; margin-left: -35vmax; background: radial-gradient(closest-side, rgba(140,110,255,.30), rgba(140,110,255,.10) 55%, transparent); }
  .aura--2 { width: 46vmax; height: 36vmax; left: 58%; top: 4vmax; background: radial-gradient(closest-side, rgba(214,170,255,.32), transparent); }

  .hero__inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hero__title { margin-top: 30px; max-width: 11.5em; font-size: var(--fs-h1); line-height: .97; letter-spacing: -0.052em; font-weight: 680; }
  .hero__actions { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

  .hero__stage { margin-top: clamp(64px, 9vw, 104px); perspective: 1600px; }
  .editor { max-width: 1060px; margin-inline: auto; padding: 0 10px 10px; transform-style: preserve-3d; }

  .editor__viewer { position: relative; aspect-ratio: 16 / 9; border-radius: 18px; overflow: hidden; background: #0d0d10; cursor: pointer; user-select: none; }
  .editor__frame {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transform: scale(calc(var(--zoom, 1) * 1.012));
    transition: opacity .9s var(--ease), transform 1.6s var(--ease);
    -webkit-user-drag: none; user-select: none; pointer-events: none;
  }
  .editor__frame.is-active { opacity: 1; transform: scale(var(--zoom, 1)); }
  /* transport bar (prev / play / next), like the controls above a timeline */
  .transport { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; padding: 10px 6px 2px; }
  .transport__count { font-size: .8rem; font-weight: 600; color: var(--ink-3); padding-left: 6px; }
  .transport__hint { justify-self: end; padding-right: 6px; font-size: .8rem; color: var(--ink-3); opacity: 0; transform: translateX(-4px); transition: opacity .5s var(--ease), transform .6s var(--ease); }
  @media (hover: hover) { .transport:has(.tbtn--play:hover) .transport__hint { opacity: 1; transform: none; } }
  .transport__btns { display: flex; align-items: center; gap: 8px; padding: 4px; border-radius: var(--r-pill); background: var(--bg); border: 1px solid var(--line); }
  .tbtn {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    color: var(--ink-2);
    transition: background-color .4s var(--ease), color .4s var(--ease), transform .5s var(--ease);
  }
  @media (hover: hover) { .tbtn:hover { background: var(--surface); color: var(--ink); box-shadow: var(--shadow-1); } }
  .tbtn:active { transform: scale(.92); }
  .tbtn--play { width: 48px; height: 48px; background: var(--accent); color: #fff; box-shadow: 0 8px 20px -8px var(--accent-glow); }
  @media (hover: hover) { .tbtn--play:hover { background: #7356FF; color: #fff; box-shadow: 0 0 0 4px rgba(107,75,255,.14), 0 10px 26px -8px rgba(107,75,255,.6); } }
  .tbtn__play { transform: none; }
  .tbtn__pause { display: none; }
  .tbtn--play.is-playing .tbtn__play { display: none; }
  .tbtn--play.is-playing .tbtn__pause { display: block; }

  .editor__meta {
    position: absolute; left: 14px; bottom: 14px; z-index: 2;
    padding: 6px 12px; border-radius: var(--r-pill);
    background: rgba(18,17,22,.6); color: #fff; font-size: .78rem; font-weight: 500;
    transition: opacity .4s var(--ease);
  }
  .editor__stop {
    position: absolute; right: 12px; top: 12px; z-index: 4;
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
    background: rgba(18,17,22,.6); color: #fff;
    opacity: 0; pointer-events: none;
    transition: opacity .4s var(--ease), transform .5s var(--ease);
  }
  @media (hover: hover) { .editor__stop:hover { transform: rotate(90deg); } }
  .editor__viewer.is-playing { cursor: default; }
  .editor__viewer.is-playing .editor__stop { opacity: 1; pointer-events: auto; }
  .editor__viewer.is-playing .editor__meta, .editor__viewer.is-playing .vglow { opacity: 0; pointer-events: none; }

  /* ---- timeline (Final Cut–style: rounded clips, attached audio, no track labels) ---- */
  .tl { margin-top: 10px; padding: 10px 14px 14px; border-radius: 16px; background: linear-gradient(180deg, #F3F2F7, #EEEDF3); border: 1px solid var(--line); }
  .tl__area {
    position: relative; display: grid;
    grid-template-rows: 18px 16px 42px 24px 18px 10px; row-gap: 4px;
    cursor: ew-resize; touch-action: pan-y; user-select: none;
  }
  .tl__ruler {
    position: relative; display: flex; justify-content: space-between; align-items: flex-start;
    font-size: .64rem; font-weight: 500; color: rgba(18,17,22,.38);
    background: repeating-linear-gradient(90deg, rgba(18,17,22,.16) 0 1px, transparent 1px 2.5%) 0 100% / 100% 4px no-repeat;
  }
  .tl__ruler span { transform: translateX(-50%); }
  .tl__ruler span:first-child { transform: none; }
  .tl__ruler span:last-child { transform: translateX(-100%); }

  .tl__track { position: relative; }
  .tl__title, .tl__clip, .tl__audio { position: absolute; top: 0; bottom: 0; left: calc(var(--s) * 100%); width: calc(var(--w) * 100%); }

  .tl__title {
    display: flex; align-items: center; padding: 0 8px; overflow: hidden;
    border-radius: 6px;
    background: linear-gradient(180deg, #A994FF, #8B72FF);
    color: #fff; font-size: .62rem; font-weight: 600; letter-spacing: .01em; white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.35), 0 1px 2px rgba(60,30,180,.2);
  }

  .tl__clip {
    display: flex; align-items: flex-end; padding: 0 0 4px 7px; overflow: hidden;
    border-radius: 8px;
    background: var(--img) left center / auto calc(100% * var(--zoom, 1)) repeat-x, #1a1a1f;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.18), 0 1px 3px rgba(0,0,0,.18);
    color: #fff; text-align: left;
    transition: box-shadow .5s var(--ease);
  }
  .tl__clip::before { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.55), rgba(0,0,0,.12) 60%); transition: opacity .5s var(--ease); }
  .tl__clip span { position: relative; font-size: .62rem; font-weight: 600; letter-spacing: .01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: calc(100% - 10px); }
  @media (hover: hover) { .tl__clip:hover::before { opacity: .7; } }
  .tl__clip.is-active::before { opacity: .6; }
  .tl__clip.is-active { box-shadow: inset 0 0 0 2px #fff, 0 0 0 2px var(--accent), 0 6px 16px -6px rgba(107,75,255,.6); }

  .tl__audio { border-radius: 6px; overflow: hidden; background: #DCEFE4; box-shadow: inset 0 0 0 1px rgba(40,140,90,.18); }
  .tl__audio svg { position: absolute; inset: 3px 4px; width: calc(100% - 8px); height: calc(100% - 6px); }
  .tl__audio :global(rect) { fill: #3FAE73; }
  .tl__audio--music { background: #E1E6FB; box-shadow: inset 0 0 0 1px rgba(80,100,200,.16); }
  .tl__audio--music :global(path) { fill: #8DA0EC; }
  .tl__audio--music::before, .tl__audio--music::after { content: ""; position: absolute; top: 0; bottom: 0; width: 14%; z-index: 1; }
  .tl__audio--music::before { left: 0; background: linear-gradient(to top right, transparent 49%, rgba(255,255,255,.55) 50%); }
  .tl__audio--music::after { right: 0; background: linear-gradient(to top left, transparent 49%, rgba(255,255,255,.55) 50%); }
  .tl__sfx { position: absolute; top: 0; bottom: 0; left: calc(var(--s) * 100%); width: 3.2%; border-radius: 4px; background: linear-gradient(180deg, #C7B8FF, #A994FF); }

  .tl__playhead, .tl__ghost { position: absolute; top: 14px; bottom: -6px; left: 0; width: 2px; margin-left: -1px; pointer-events: none; will-change: transform; border-radius: 2px; }
  .tl__playhead { background: var(--accent); z-index: 3; box-shadow: 0 0 10px rgba(107,75,255,.45); }
  .tl__playhead span { position: absolute; top: -9px; left: 50%; width: 12px; height: 12px; transform: translateX(-50%); border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px #fff, 0 2px 8px rgba(107,75,255,.5); }
  .tl__ghost { background: rgba(107,75,255,.3); opacity: 0; transition: opacity .3s var(--ease); z-index: 2; }
  @media (hover: hover) { .tl__area:hover .tl__ghost { opacity: 1; } }

  .hero__hint { margin-top: 18px; text-align: center; font-size: .8rem; color: var(--ink-3); }

  @media (max-width: 640px) {
    .hero { padding-top: 124px; }
    .hero__title { margin-top: 24px; }
    .hero__actions { margin-top: 30px; }
    .hero__stage { margin-top: 52px; }
    .editor { padding: 0 6px 6px; border-radius: 22px; }
    .editor .window__bar { grid-template-columns: auto 1fr 40px; gap: 10px; padding: 0 12px; }
    .editor__viewer { border-radius: 16px; }
    .transport__hint { display: none; }
    .tbtn { width: 36px; height: 36px; }
    .tbtn--play { width: 44px; height: 44px; }
    .tl { padding: 8px 10px 12px; }
    .tl__area { grid-template-rows: 16px 0 34px 18px 14px 0; }
    .tl__track--titles, .tl__track--sfx { visibility: hidden; }
    .tl__ruler span:nth-child(even) { visibility: hidden; }
    .tl__clip span { display: none; }
  }
</style>
