---
/* Small section label: a purple shape that slowly turns from a circle into a
   soft four-point star and back (pure CSS, runs on the GPU) + text */
---
<p class="label" data-reveal>
  <span class="label__shape" aria-hidden="true">
    <svg class="label__circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" fill="currentColor" /></svg>
    <svg class="label__star" viewBox="0 0 24 24"><path fill="currentColor" d="M12 1.5C13.4 7.6 16.4 10.6 22.5 12C16.4 13.4 13.4 16.4 12 22.5C10.6 16.4 7.6 13.4 1.5 12C7.6 10.6 10.6 7.6 12 1.5Z" /></svg>
  </span>
  <slot />
</p>
