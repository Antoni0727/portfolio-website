---
import type { Video } from '../data/work';
import { thumb } from '../data/work';
import { icons } from '../data/icons';

interface Props { video: Video; short?: boolean; }
const { video, short = false } = Astro.props;
const src = video.thumb ?? (short ? thumb.short(video.id) : thumb.max(video.id));
---
<article class:list={['vcard', short && 'vcard--short']}>
  <div class="vcard__frame">
    <div class="vcard__media" data-video={video.id} data-glow role="button" tabindex="0" aria-label={`Play: ${video.title}`}>
      <img src={src} alt="" width={short ? 405 : 1280} height="720" loading="lazy" decoding="async" draggable="false" style={video.zoom ? `--zoom:${video.zoom}` : undefined} />
      <span class="vglow" aria-hidden="true"></span>
      <span class="vcard__ring" aria-hidden="true" data-ring></span>
      <span class="vcard__badge" aria-hidden="true"><i set:html={icons.play(short ? 11 : 12)} />{!short && <span>Play</span>}</span>
      <button class="vcard__stop" type="button" data-stop aria-label="Stop video" set:html={icons.close(12)} />
    </div>
  </div>
  <div class="vcard__body">
    <p class="vcard__meta">{video.meta.join(' · ')}</p>
    <h3 class="vcard__title">{video.title}</h3>
  </div>
</article>

<style is:global>
  .vcard { --r-card: var(--r); }
  .vcard--short { --r-card: 18px; }

  .vcard__frame { position: relative; border-radius: var(--r-card); box-shadow: var(--shadow-1); transition: transform .9s var(--ease); }
  .vcard__frame::before {
    content: ""; position: absolute; inset: -1.5px; border-radius: calc(var(--r-card) + 1.5px); z-index: 0;
    background: linear-gradient(140deg, rgba(185,169,255,.95), rgba(107,75,255,.6) 40%, rgba(214,204,255,.9));
    opacity: 0; transition: opacity .8s var(--ease);
  }
  .vcard__frame::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; z-index: -1;
    box-shadow: 0 2px 4px rgba(30,18,80,.06), 0 12px 24px -8px rgba(30,18,80,.16), 0 40px 80px -24px rgba(90,60,220,.38);
    opacity: 0; transition: opacity .9s var(--ease);
  }

  .vcard__media {
    position: relative; z-index: 1; aspect-ratio: 16 / 9;
    border-radius: var(--r-card); overflow: hidden;
    background: #0d0d10; cursor: pointer;
    transform: translateZ(0);
    -webkit-mask-image: -webkit-radial-gradient(white, black); /* iOS: no square corners while animating */
  }
  .vcard__media img { width: 100%; height: 100%; object-fit: cover; transform: scale(var(--zoom, 1)); transition: transform 1.4s var(--ease), opacity .7s var(--ease); -webkit-user-drag: none; user-select: none; }
  .js .vcard__media img:not(.is-in) { opacity: 0; }

  /* cursor-following purple glow (position set from JS, no lag) */
  .vglow {
    position: absolute; left: 0; top: 0; z-index: 1; pointer-events: none;
    width: 480px; height: 480px; margin: -240px 0 0 -240px; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(160,135,255,.34), rgba(120,90,255,.1) 55%, transparent);
    transform: translate3d(var(--gx, -999px), var(--gy, -999px), 0);
    opacity: 0; transition: opacity .35s ease;
  }
  @media (hover: hover) { .vcard__media:hover .vglow, .editor__viewer:hover .vglow { opacity: 1; } }

  .vcard__ring {
    position: absolute; left: 50%; top: 50%; z-index: 1;
    width: 120px; height: 120px; margin: -60px 0 0 -60px; border-radius: 50%;
    border: 1px solid rgba(200,185,255,.45);
    box-shadow: 0 0 40px 10px rgba(130,100,255,.35), inset 0 0 40px 6px rgba(130,100,255,.3);
    opacity: 0; pointer-events: none;
  }

  .vcard__badge {
    position: absolute; left: 12px; bottom: 12px; z-index: 2;
    display: inline-flex; align-items: center; gap: 6px;
    height: 30px; padding: 0 12px 0 9px; border-radius: var(--r-pill);
    background: rgba(18,17,22,.62); color: #fff;
    font-size: .76rem; font-weight: 600;
    transition: background-color .45s var(--ease), transform .6s var(--ease);
  }
  .vcard__badge i { display: inline-grid; }
  .vcard--short .vcard__badge { padding: 0; width: 30px; justify-content: center; left: 10px; bottom: 10px; }

  @media (hover: hover) {
    .vcard__frame:hover { transform: translateY(-6px); }
    .vcard__frame:hover::before, .vcard__frame:hover::after { opacity: 1; }
    .vcard__frame:hover img { transform: scale(calc(var(--zoom, 1) * 1.015)); }
    .vcard__frame:hover .vcard__badge { background: var(--accent); transform: translateY(-2px); }
    .vcard:hover .vcard__title { color: var(--accent-700); transform: translateX(3px); }
    .vcard:hover .vcard__meta { transform: translateX(3px); }
  }
  .vcard__media:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .vcard__stop {
    position: absolute; right: 10px; top: 10px; z-index: 4;
    display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    background: rgba(18,17,22,.6); color: #fff;
    opacity: 0; pointer-events: none;
    transition: opacity .4s var(--ease), transform .5s var(--ease);
  }
  @media (hover: hover) { .vcard__stop:hover { transform: rotate(90deg); } }
  .vcard__media.is-playing { cursor: default; }
  .vcard__media.is-playing .vcard__stop { opacity: 1; pointer-events: auto; }
  .vcard__media.is-playing .vcard__badge, .vcard__media.is-playing .vcard__ring, .vcard__media.is-playing .vglow { opacity: 0 !important; }
  .vcard__frame:has(.is-playing) { transform: none !important; }

  .vcard__body { padding: 18px 4px 0; }
  .vcard__meta { font-size: var(--fs-small); color: var(--ink-3); transition: transform .8s var(--ease); }
  .vcard__title { margin-top: 4px; font-size: 1.2rem; font-weight: 620; letter-spacing: -0.022em; line-height: 1.3; transition: color .6s var(--ease), transform .8s var(--ease); }

  .vcard--short .vcard__media { aspect-ratio: 9 / 16; }
  .vcard--short .vcard__body { padding-top: 14px; }
  .vcard--short .vcard__meta { font-size: .8rem; }
  .vcard--short .vcard__title { font-size: 1rem; margin-top: 2px; }
  .vcard--short .vcard__ring { width: 90px; height: 90px; margin: -45px 0 0 -45px; }
</style>
