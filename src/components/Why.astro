---
import Label from './Label.astro';
import { Picture } from 'astro:assets';
import tony from '../assets/tony.jpg';
import { comparison } from '../data/content';
---
<section class="section" id="why" aria-labelledby="why-title">
  <div class="container">
    <div class="why__head">
      <Label>Why me</Label>
      <h2 class="h2 why__title" id="why-title" data-split>
        Most edits try to <span class="strike" data-strike>impress</span><br>
        Mine are made for the <span class="sel" data-sel>viewer</span>
      </h2>
      <p class="lead" data-reveal>Flashy, chaotic effects don't keep people watching. Story, pacing, sound, clean animation and color do.</p>
    </div>

    <div class="vs" data-vs>
      <span class="vs__panel vs__panel--them" aria-hidden="true" style={`grid-row: 1 / span ${comparison.length + 1}`}></span>
      <span class="vs__panel vs__panel--me" aria-hidden="true" style={`grid-row: 1 / span ${comparison.length + 1}`}><i></i></span>

      <p class="vs__head vs__head--them">Other editors</p>
      <span aria-hidden="true" style="grid-row:1;grid-column:2"></span>
      <p class="vs__head vs__head--me">
        <Picture src={tony} formats={['avif', 'webp']} width={56} height={56} alt="" class="vs__avatar" />
        Working with me
      </p>

      {comparison.map((row, i) => (
        <>
          <p class="vs__cell vs__cell--them" data-vs-them style={`grid-row:${i + 2}`}>
            <i class="vs__x" aria-hidden="true"></i><span><span class="visually-hidden">Other editors: </span>{row.them}</span>
          </p>
          <span class="vs__link" aria-hidden="true" data-vs-link style={`grid-row:${i + 2};grid-column:2`}><i></i></span>
          <p class="vs__cell vs__cell--me" data-vs-me style={`grid-row:${i + 2}`}>
            <i class="vs__check" aria-hidden="true"></i><span><span class="visually-hidden">Me: </span>{row.me}</span>
          </p>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .why__head { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: clamp(40px, 5vw, 64px); }
  .why__head .lead { margin-top: 20px; max-width: 30em; }
  .why__title { max-width: 14em; }
  .strike { position: relative; display: inline-block; color: var(--ink-3); }
  .strike::after {
    content: ""; position: absolute; left: -.04em; right: -.04em; top: 54%;
    height: max(3px, .06em); border-radius: 9px; background: var(--accent);
    transform: scaleX(var(--strike, 0)); transform-origin: left;
  }

  /* ---- comparison table ---- */
  .vs {
    position: relative; isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(36px, 7vw, 88px) minmax(0, 1.12fr);
    max-width: 980px; margin-inline: auto;
  }
  .vs__panel { position: relative; z-index: -1; border-radius: 28px; }
  .vs__panel--them { grid-column: 1; background: var(--bg-2); border: 1px solid var(--line); }
  .vs__panel--me {
    grid-column: 3; overflow: hidden;
    background: linear-gradient(165deg, #7A5CFF 0%, #5B3BF2 55%, #4326C8 100%);
    box-shadow: 0 30px 70px -24px rgba(91,59,242,.55), inset 0 1px 0 rgba(255,255,255,.25);
  }
  .vs__panel--me i {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 60% at 85% -10%, rgba(255,255,255,.28), transparent 60%),
      radial-gradient(80% 50% at 0% 110%, rgba(214,170,255,.35), transparent 60%);
  }

  .vs__head { display: flex; align-items: center; gap: 10px; padding: 26px 28px 18px; font-size: .95rem; font-weight: 650; letter-spacing: -0.015em; }
  .vs__head--them { grid-column: 1; grid-row: 1; color: var(--ink-3); }
  .vs__head--me { grid-column: 3; grid-row: 1; color: #fff; }
  .vs__head :global(picture) { display: block; flex: none; }
  .vs__head :global(.vs__avatar) { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px rgba(255,255,255,.5); }

  .vs__cell {
    display: flex; align-items: center; gap: 12px;
    min-height: 64px; margin: 0 28px; padding: 14px 0;
    border-top: 1px solid var(--line);
    font-size: clamp(.95rem, .9rem + .3vw, 1.08rem); font-weight: 560; letter-spacing: -0.015em; line-height: 1.3;
  }
  .vs__cell--them { grid-column: 1; color: var(--ink-3); }
  .vs__cell--me { grid-column: 3; color: #fff; border-top-color: rgba(255,255,255,.16); }
  .vs > :last-child, .vs > :nth-last-child(3) { padding-bottom: 26px; }

  .vs__x, .vs__check { position: relative; flex: none; width: 22px; height: 22px; border-radius: 50%; }
  .vs__x { background: var(--bg); box-shadow: inset 0 0 0 1px var(--line-2); }
  .vs__x::before, .vs__x::after { content: ""; position: absolute; left: 50%; top: 50%; width: 9px; height: 1.6px; border-radius: 2px; background: var(--ink-3); }
  .vs__x::before { transform: translate(-50%, -50%) rotate(45deg); }
  .vs__x::after { transform: translate(-50%, -50%) rotate(-45deg); }
  .vs__check { background: #fff; box-shadow: 0 4px 12px -4px rgba(0,0,0,.35); }
  .vs__check::after { content: ""; position: absolute; left: 7.5px; top: 4.5px; width: 5px; height: 9.5px; border: solid #5B3BF2; border-width: 0 2.2px 2.2px 0; transform: rotate(45deg); }

  /* horizontal link between the two answers of a row */
  .vs__link { position: relative; display: flex; align-items: center; }
  .vs__link i { position: relative; display: block; width: 100%; height: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--line-2), var(--accent)); transform-origin: left; }
  .vs__link i::after { content: ""; position: absolute; right: -1px; top: 50%; width: 8px; height: 8px; margin-top: -4px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }

  /* row hover: my answer glows, the other side lights up softly */
  .vs__cell { position: relative; }
  .vs__cell::before {
    content: ""; position: absolute; z-index: -1; inset: 6px -14px; border-radius: 16px;
    opacity: 0; transform: scale(.97); transition: opacity .35s var(--ease), transform .45s var(--ease);
  }
  .vs__cell--them::before { background: var(--surface); box-shadow: 0 0 0 1px var(--line), 0 8px 22px -14px rgba(18,17,22,.25); }
  .vs__cell--me::before {
    background: rgba(255,255,255,.2);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.4), 0 0 42px -2px rgba(214,170,255,.9), 0 0 0 4px rgba(255,255,255,.06);
  }
  .vs__check { transition: scale .4s var(--ease), box-shadow .4s var(--ease); }
  .vs__x { transition: box-shadow .35s var(--ease); }
  .vs__cell--them span { transition: color .35s var(--ease); }
  .vs__link i { transition: box-shadow .35s var(--ease), filter .35s var(--ease); }
  @media (hover: hover) {
    .vs__cell.is-hot::before { opacity: 1; transform: none; }
    .vs__cell--them.is-hot span { color: var(--ink-2); }
    .vs__cell--them.is-hot .vs__x { box-shadow: inset 0 0 0 1px var(--ink-3); }
    .vs__cell--me.is-hot .vs__check { scale: 1.14; box-shadow: 0 0 0 4px rgba(255,255,255,.18), 0 0 22px rgba(255,255,255,.7); }
    .vs__link.is-hot i { filter: brightness(1.25); box-shadow: 0 0 12px var(--accent); }
  }

  @media (max-width: 640px) {
    .vs { grid-template-columns: minmax(0, 1fr) 14px minmax(0, 1.08fr); }
    .vs__panel { border-radius: 20px; }
    .vs__head { padding: 18px 14px 12px; font-size: .82rem; gap: 7px; }
    .vs__head :global(.vs__avatar) { width: 22px; height: 22px; }
    .vs__cell { margin: 0 14px; gap: 8px; min-height: 58px; font-size: .84rem; }
    .vs > :last-child, .vs > :nth-last-child(3) { padding-bottom: 18px; }
    .vs__x, .vs__check { width: 18px; height: 18px; }
    .vs__check::after { left: 6px; top: 3.5px; width: 4px; height: 8px; border-width: 0 2px 2px 0; }
    .vs__x::before, .vs__x::after { width: 7px; }
    .vs__link i::after { display: none; }
  }

  :global(.js) [data-vs-them], :global(.js) [data-vs-me] { opacity: 0; }
  :global(.js) [data-vs-link] i { transform: scaleX(0); }
</style>
