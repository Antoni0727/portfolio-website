---
import Label from './Label.astro';
import { Picture } from 'astro:assets';
import tony from '../assets/tony.jpg';
import { comparison } from '../data/content';
import { icons } from '../data/icons';
---
<section class="section" id="why" aria-labelledby="why-title">
  <div class="container">
    <div class="why__head">
      <Label>Why me</Label>
      <h2 class="h2 why__title" id="why-title" data-split>
        Most edits try to <span class="strike" data-strike>impress</span><br>
        Mine are made for the <span class="sel" data-sel>viewer</span>
      </h2>
      <p class="lead" data-reveal>Flashy, chaotic effects don't keep people watching. Story, pacing, sound, clean animation and color do.</p>
    </div>

    <div class="vs" data-vs>
      <span class="vs__panel vs__panel--them" aria-hidden="true" data-vs-panel style={`grid-row: 1 / span ${comparison.length + 2}`}></span>
      <span class="vs__panel vs__panel--me" aria-hidden="true" data-vs-panel style={`grid-row: 1 / span ${comparison.length + 2}`}><i></i><b class="vs__shine" data-vs-shine></b></span>

      <p class="vs__head vs__head--them" data-vs-head><span class="vs__badge" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><circle cx="12" cy="9" r="4" fill="currentColor"/><path d="M4.5 20.5c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5" fill="currentColor"/></svg></span>Other editors</p>
      <span aria-hidden="true" style="grid-row:1;grid-column:2"></span>
      <p class="vs__head vs__head--me" data-vs-head>
        <Picture src={tony} formats={['avif', 'webp']} width={64} height={64} alt="" class="vs__avatar" />
        Working with me
      </p>

      {comparison.map((row, i) => (
        <>
          <p class="vs__cell vs__cell--them" data-vs-them style={`grid-row:${i + 2}`}>
            <i class="vs__x" aria-hidden="true" set:html={icons.close(9)} /><span><span class="visually-hidden">Other editors: </span>{row.them}</span>
          </p>
          <span class="vs__link" aria-hidden="true" data-vs-link style={`grid-row:${i + 2};grid-column:2`}><i></i></span>
          <p class="vs__cell vs__cell--me" data-vs-me style={`grid-row:${i + 2}`}>
            <i class="vs__check" aria-hidden="true" set:html={icons.check(12)} /><span><span class="visually-hidden">Me: </span>{row.me}</span>
          </p>
        </>
      ))}
      <span class="vs__end" aria-hidden="true" style={`grid-row:${comparison.length + 2}`}></span>
    </div>
  </div>
</section>

<style>
  .why__head { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: clamp(40px, 5vw, 64px); }
  .why__head .lead { margin-top: 20px; max-width: 30em; }
  .why__title { max-width: 14em; }
  .strike { position: relative; display: inline-block; color: var(--ink-3); }
  .strike::after {
    content: ""; position: absolute; left: -.04em; right: -.04em; top: 54%;
    height: max(3px, .06em); border-radius: 9px; background: var(--accent);
    transform: scaleX(var(--strike, 0)); transform-origin: left;
  }

  /* ---- comparison table ---- */
  .vs {
    position: relative; isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(32px, 5vw, 64px) minmax(0, 1fr);
    max-width: 840px; margin-inline: auto;
  }
  .vs__panel { position: relative; z-index: -1; border-radius: 28px; overflow: hidden; }
  .vs__panel--them { grid-column: 1; background: var(--bg-2); border: 1px solid var(--line); }
  .vs__panel--me {
    grid-column: 3;
    background: linear-gradient(165deg, #7A5CFF 0%, #5B3BF2 55%, #4326C8 100%);
    box-shadow: 0 30px 70px -24px rgba(91,59,242,.55), inset 0 1px 0 rgba(255,255,255,.25);
  }
  .vs__panel--me i {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 60% at 85% -10%, rgba(255,255,255,.28), transparent 60%),
      radial-gradient(80% 50% at 0% 110%, rgba(214,170,255,.35), transparent 60%);
  }
  .vs__shine {
    position: absolute; top: 0; bottom: 0; left: -60%; width: 60%;
    background: linear-gradient(100deg, transparent, rgba(255,255,255,.22) 50%, transparent);
    transform: translateX(0); opacity: 0;
  }

  /* column titles: a band across the top of each panel */
  .vs__head {
    position: relative; display: flex; align-items: center; gap: 11px;
    margin: 0; padding: 22px 28px 20px;
    font-size: clamp(1.02rem, .96rem + .3vw, 1.18rem); font-weight: 700; letter-spacing: -0.025em;
  }
  .vs__head::before { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: 28px 28px 0 0; }
  .vs__head--them { grid-column: 1; grid-row: 1; color: var(--ink-2); }
  .vs__head--them::before { background: var(--hover); border-bottom: 1px solid var(--line-2); }
  .vs__head--me { grid-column: 3; grid-row: 1; color: #fff; }
  .vs__head--me::before { background: rgba(255,255,255,.1); border-bottom: 1px solid rgba(255,255,255,.22); }
  .vs__badge { display: grid; place-items: end center; flex: none; width: 30px; height: 30px; border-radius: 50%; overflow: hidden; background: var(--line-2); color: var(--ink-3); }
  .vs__head :global(picture) { display: block; flex: none; }
  .vs__head :global(.vs__avatar) { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px rgba(255,255,255,.6); }

  .vs__cell {
    position: relative;
    display: flex; align-items: center; gap: 12px;
    min-height: 62px; margin: 0 28px; padding: 14px 0;
    font-size: clamp(.95rem, .9rem + .3vw, 1.06rem); font-weight: 560; letter-spacing: -0.015em; line-height: 1.3;
  }
  .vs__cell + .vs__cell, .vs__link + .vs__cell { border-top: 1px solid var(--line); }
  .vs__cell--them { grid-column: 1; color: var(--ink-3); }
  .vs__cell--me { grid-column: 3; color: #fff; }
  .vs__link + .vs__cell--me { border-top-color: rgba(255,255,255,.16); }
  .vs > [data-vs-them]:nth-child(6), .vs > [data-vs-me]:nth-child(8) { border-top: 0; }
  .vs__end { grid-column: 1 / -1; height: 12px; }

  .vs__x, .vs__check { display: grid; place-items: center; flex: none; width: 22px; height: 22px; border-radius: 50%; }
  .vs__x { background: var(--bg); color: var(--ink-3); box-shadow: inset 0 0 0 1px var(--line-2); }
  .vs__check { background: #fff; color: #5B3BF2; box-shadow: 0 4px 12px -4px rgba(0,0,0,.35); }
  .vs__x :global(svg), .vs__check :global(svg) { display: block; }

  /* horizontal link between the two answers of a row */
  .vs__link { position: relative; display: flex; align-items: center; }
  .vs__link i { position: relative; display: block; width: 100%; height: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--line-2), var(--accent)); transform-origin: left; }
  .vs__link i::after { content: ""; position: absolute; right: -1px; top: 50%; width: 8px; height: 8px; margin-top: -4px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }

  /* row hover: my answer glows, the other side lights up softly. Slow in, slower out. */
  .vs { --hover-ease: cubic-bezier(.22, .8, .2, 1); }
  .vs__cell::before {
    content: ""; position: absolute; z-index: -1; inset: 7px -14px; border-radius: 16px;
    opacity: 0; transform: scale(.985);
    transition: opacity 1.1s var(--hover-ease), transform 1.3s var(--hover-ease);
  }
  .vs__cell--them::before { background: var(--surface); box-shadow: 0 0 0 1px var(--line), 0 8px 22px -14px rgba(18,17,22,.25); }
  .vs__cell--me::before {
    background: rgba(255,255,255,.18);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.38), 0 0 46px -2px rgba(214,170,255,.85), 0 0 0 4px rgba(255,255,255,.05);
  }
  .vs__cell > span { transition: color 1s var(--hover-ease), transform 1.2s var(--hover-ease); }
  .vs__check { transition: scale 1.2s var(--hover-ease), box-shadow 1.2s var(--hover-ease); }
  .vs__x { transition: box-shadow 1s var(--hover-ease), color 1s var(--hover-ease); }
  .vs__link i { transition: box-shadow 1.1s var(--hover-ease), filter 1.1s var(--hover-ease); }
  @media (hover: hover) {
    .vs__cell.is-hot::before { opacity: 1; transform: none; transition-duration: .8s, 1s; }
    .vs__cell.is-hot > span { transform: translateX(3px); }
    .vs__cell--them.is-hot > span { color: var(--ink-2); }
    .vs__cell--them.is-hot .vs__x { box-shadow: inset 0 0 0 1px var(--ink-3); color: var(--ink-2); }
    .vs__cell--me.is-hot .vs__check { scale: 1.1; box-shadow: 0 0 0 4px rgba(255,255,255,.16), 0 0 24px rgba(255,255,255,.6); }
    .vs__link.is-hot i { filter: brightness(1.25); box-shadow: 0 0 12px var(--accent); }
  }

  @media (max-width: 640px) {
    .vs { grid-template-columns: minmax(0, 1fr) 12px minmax(0, 1fr); }
    .vs__panel { border-radius: 20px; }
    .vs__head { padding: 15px 12px 13px; font-size: .86rem; gap: 7px; letter-spacing: -0.02em; }
    .vs__head::before { border-radius: 20px 20px 0 0; }
    .vs__badge { width: 22px; height: 22px; }
    .vs__badge svg { width: 13px; height: 13px; }
    .vs__head :global(.vs__avatar) { width: 22px; height: 22px; }
    .vs__cell { margin: 0 12px; gap: 8px; min-height: 58px; font-size: .84rem; }
    .vs__end { height: 6px; }
    .vs__x, .vs__check { width: 18px; height: 18px; }
    .vs__check :global(svg) { width: 10px; height: 10px; }
    .vs__x :global(svg) { width: 8px; height: 8px; }
    .vs__link i::after { display: none; }
  }

  :global(.js) [data-vs-them], :global(.js) [data-vs-me], :global(.js) [data-vs-head], :global(.js) [data-vs-panel] { opacity: 0; }
  :global(.js) [data-vs-link] i { transform: scaleX(0); }
</style>
