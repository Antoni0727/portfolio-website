---
import Label from './Label.astro';
import { Picture } from 'astro:assets';
import tony from '../assets/tony.jpg';
import { site } from '../data/site';
import { icons } from '../data/icons';

const journey = [
  { when: '2024', what: 'First edit: a trip vlog with friends. The editing part became an obsession.' },
  { when: '2025', what: 'Started my own YouTube channel, teaching what I learned about editing.' },
  { when: 'Now', what: 'Editing full-time for creators, long-form and short-form.' },
];
---
<section class="section" id="about" aria-labelledby="about-title">
  <div class="container about">
    <div class="about__photo" data-reveal-img data-parallax>
      <Picture
        src={tony}
        formats={['avif', 'webp']}
        widths={[600, 900, 1300]}
        width={1300}
        sizes="(min-width: 900px) 460px, 100vw"
        alt="Tony, seen from behind, looking out at a pink sunset over forested hills"
        loading="lazy"
      />
      <span class="about__badge"><i set:html={icons.pin(14)} />{site.location} · {site.timezone}</span>
    </div>

    <div class="about__text">
      <Label>About</Label>
      <h2 class="h2" id="about-title" data-split>Hi, I'm <span class="sel" data-sel>Tony</span></h2>
      <div class="prose" data-reveal>
        <p>I'm a 19-year-old video editor. It started in 2024 with a short vlog from a trip with friends, and the editing part quickly became an obsession. Since finishing high school, it's been my full-time work.</p>
        <p>I also run my own YouTube channel, where I teach what I've learned about editing. <strong>Because I make content myself, I understand the whole process, from the first idea to the final upload.</strong> I know what earns the click, what keeps viewers watching and where they drop off, so every edit is made for your video's performance, not just its looks.</p>
      </div>

      <ol class="journey" data-journey>
        <span class="journey__track" aria-hidden="true"><span class="journey__fill" data-journey-fill></span></span>
        {journey.map((j) => (
          <li data-reveal><span class="journey__dot" aria-hidden="true"></span><b class="num">{j.when}</b><p>{j.what}</p></li>
        ))}
      </ol>

      <ul class="chips" aria-label="Skills" data-reveal>
        <li>Hooks &amp; retention</li><li>Storytelling</li><li>Sound design</li><li>Motion graphics</li><li>Color grading</li><li>Captions</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 460px) minmax(0, 1fr); gap: clamp(36px, 6vw, 100px); align-items: center; }
  @media (max-width: 900px) { .about { grid-template-columns: 1fr; } }

  .about__photo { position: relative; aspect-ratio: 4 / 5; border-radius: var(--r-l); overflow: hidden; box-shadow: var(--shadow-3); }
  .about__photo :global(picture), .about__photo :global(img) { display: block; width: 100%; height: 100%; }
  .about__photo :global(img) { object-fit: cover; transform: scale(1.12); will-change: transform; }
  @media (max-width: 900px) { .about__photo { max-width: 460px; } }
  .about__badge {
    position: absolute; left: 16px; bottom: 16px;
    display: inline-flex; align-items: center; gap: 7px;
    padding: 8px 14px; border-radius: var(--r-pill);
    background: rgba(253,253,254,.92); font-size: .82rem; font-weight: 560;
  }
  .about__badge i { display: inline-grid; color: var(--accent); }

  .prose { margin-top: 24px; max-width: 36em; }
  .prose p { color: var(--ink-2); }
  .prose p + p { margin-top: 16px; }
  .prose strong { color: var(--ink); font-weight: 620; }

  .journey { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; padding-top: 26px; }
  .journey__track { position: absolute; left: 6px; right: 6px; top: 6px; height: 2px; border-radius: 2px; background: var(--line-2); overflow: hidden; }
  .journey__fill { position: absolute; inset: 0; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  .journey li { position: relative; }
  .journey__dot { position: absolute; left: 0; top: -26px; width: 14px; height: 14px; border-radius: 50%; background: var(--surface); border: 2px solid var(--accent); box-shadow: 0 0 0 5px var(--accent-50); }
  .journey b { display: block; font-size: .85rem; font-weight: 650; color: var(--accent-700); }
  .journey p { margin-top: 6px; font-size: .92rem; line-height: 1.5; color: var(--ink-3); }
  @media (max-width: 560px) {
    .journey { grid-template-columns: 1fr; padding-top: 0; padding-left: 30px; gap: 22px; }
    .journey__track { left: 6px; right: auto; top: 6px; bottom: 6px; width: 2px; height: auto; }
    .journey__fill { transform-origin: top; }
    .journey__dot { left: -30px; top: 2px; }
  }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 36px; }
  .chips li { padding: 8px 15px; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line); font-size: .86rem; color: var(--ink-2); transition: border-color .6s var(--ease), color .6s var(--ease), transform .7s var(--ease); }
  @media (hover: hover) { .chips li:hover { border-color: var(--accent-200); color: var(--accent-700); transform: translateY(-3px); } }
</style>
