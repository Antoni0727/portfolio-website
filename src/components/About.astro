---
import Label from './Label.astro';
import { Picture } from 'astro:assets';
import tony from '../assets/tony-face.jpg';
import '@fontsource/caveat/latin-600.css';
import { site } from '../data/site';
import { icons } from '../data/icons';

const journey = [
  { when: '2019', what: 'Started my first YouTube channel and edited my own videos.' },
  { when: '2024', what: 'A trip vlog pulled me back into editing. It became an obsession.' },
  { when: '2025', what: 'Launched a YouTube channel teaching editing in DaVinci Resolve.' },
  { when: 'Now', what: 'Editing full-time for creators, long-form and short-form.' },
];
---
<section class="section" id="about" aria-labelledby="about-title">
  <div class="container about">
    <div class="about__photo" data-reveal-img data-parallax>
      <Picture
        src={tony}
        formats={['webp']}
        widths={[640, 1000, 1400, 1800]}
        width={1800}
        quality={88}
        sizes="(min-width: 900px) 520px, 100vw"
        alt="Tony taking a mirror selfie in a grey hoodie"
        loading="lazy"
      />
      <span class="about__name" aria-hidden="true">Tony</span>
      <span class="about__badge"><i set:html={icons.pin(14)} />{site.location} · {site.timezone}</span>
    </div>

    <div class="about__text">
      <Label>About</Label>
      <h2 class="h2" id="about-title" data-split>Hi, I'm <span class="sel" data-sel>Tony</span></h2>
      <div class="prose" data-reveal>
        <p>I'm a video editor for creators. I first got into video in 2019 with my own YouTube channel. In 2024, a short vlog from a trip with friends pulled me back in, and the editing part quickly became an obsession. Today, it's my full-time work.</p>
        <p>I also run a YouTube channel where I teach editing in DaVinci Resolve. <strong>Because I make content myself, I understand the whole process, from the first idea to the final upload.</strong> I know what earns the click, what keeps viewers watching and where they drop off, so every edit is made for your video's performance, not just its looks.</p>
      </div>

      <ol class="journey" data-journey>
        <span class="journey__track" aria-hidden="true"><span class="journey__fill" data-journey-fill></span></span>
        {journey.map((j) => (
          <li data-reveal><span class="journey__dot" aria-hidden="true"></span><b class="num">{j.when}</b><p>{j.what}</p></li>
        ))}
      </ol>

    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 460px) minmax(0, 1fr); gap: clamp(36px, 6vw, 100px); align-items: center; }
  @media (max-width: 900px) { .about { grid-template-columns: 1fr; } }

  .about__photo { position: relative; aspect-ratio: 4 / 5; border-radius: var(--r-l); overflow: hidden; box-shadow: var(--shadow-3); }
  .about__photo :global(picture), .about__photo :global(img) { display: block; width: 100%; height: 100%; }
  .about__photo :global(img) { object-fit: cover; transform: scale(1.12); will-change: transform; }
  @media (max-width: 900px) { .about__photo { max-width: 460px; } }
  .about__badge {
    position: absolute; left: 16px; bottom: 16px;
    display: inline-flex; align-items: center; gap: 7px;
    padding: 8px 14px; border-radius: var(--r-pill);
    background: var(--glass); font-size: .82rem; font-weight: 560;
  }
  /* soft shade at the bottom so the name and badge read on any photo */
  .about__photo::after {
    content: ""; position: absolute; inset: 45% 0 0 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to top, rgba(12,10,20,.62), rgba(12,10,20,.28) 45%, transparent);
  }
  .about__badge { z-index: 2; }
  .about__name {
    position: absolute; z-index: 2; left: 22px; bottom: 58px;
    font-family: 'Caveat', cursive; font-weight: 600; font-size: clamp(2rem, 1.6rem + 1.2vw, 2.6rem); line-height: 1;
    color: #fff; transform: rotate(-7deg); transform-origin: left bottom;
    text-shadow: 0 2px 12px rgba(0,0,0,.45), 0 1px 2px rgba(0,0,0,.35);
    pointer-events: none;
  }
  .about__badge i { display: inline-grid; color: var(--accent); }

  .prose { margin-top: 24px; max-width: 36em; }
  .prose p { color: var(--ink-2); }
  .prose p + p { margin-top: 16px; }
  .prose strong { color: var(--ink); font-weight: 620; }

  .journey { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 40px; padding-top: 26px; }
  .journey__track { position: absolute; left: 6px; right: 6px; top: 6px; height: 2px; border-radius: 2px; background: var(--line-2); overflow: hidden; }
  .journey__fill { position: absolute; inset: 0; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  .journey li { position: relative; }
  .journey__dot { position: absolute; left: 0; top: -26px; width: 14px; height: 14px; border-radius: 50%; background: var(--surface); border: 2px solid var(--accent); box-shadow: 0 0 0 5px var(--accent-50); }
  .journey b { display: block; font-size: .85rem; font-weight: 650; color: var(--accent-700); }
  .journey p { margin-top: 6px; font-size: .9rem; line-height: 1.5; color: var(--ink-3); }
  @media (max-width: 620px), (min-width: 901px) and (max-width: 1080px) {
    .journey { grid-template-columns: 1fr; padding-top: 0; padding-left: 30px; gap: 22px; }
    .journey__track { left: 6px; right: auto; top: 6px; bottom: 6px; width: 2px; height: auto; }
    .journey__fill { transform-origin: top; }
    .journey__dot { left: -30px; top: 2px; }
  }

</style>
