---
import { proof } from '../data/content';
---
<section class="proof" aria-label="At a glance">
  <div class="container">
    <ul class="proof__list">
      {proof.map((p) => (
        <li data-reveal><strong>{p.value}</strong><span>{p.label}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .proof { padding: 24px 0 0; }
  .proof__list { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid var(--line); }
  .proof__list li { display: flex; flex-direction: column; gap: 6px; padding: 30px 26px; }
  .proof__list li:not(:first-child) { border-left: 1px solid var(--line); }
  strong { font-size: clamp(1.45rem, 1.1rem + 1vw, 2rem); font-weight: 640; letter-spacing: -0.035em; line-height: 1.1; }
  span { font-size: var(--fs-small); color: var(--ink-3); line-height: 1.45; }
  @media (max-width: 860px) {
    .proof__list { grid-template-columns: repeat(2, 1fr); }
    .proof__list li:nth-child(odd) { border-left: 0; }
    .proof__list li:nth-child(even) { border-left: 1px solid var(--line); }
    .proof__list li:nth-child(n+3) { border-top: 1px solid var(--line); }
    .proof__list li { padding: 22px 16px; }
  }
</style>
