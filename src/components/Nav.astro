---
import Button from './Button.astro';
import Logo from './Logo.astro';
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#process', label: 'Process' },
  { href: '/#about', label: 'About' },
  { href: '/#faq', label: 'FAQ' },
];
---
<header class="nav" data-nav>
  <div class="nav__inner">
    <a href="/" class="brand" aria-label="Tony J Edits, home"><Logo size={28} class="brand__mark" /><span class="brand__word">Tony J Edits</span></a>
    <nav aria-label="Primary">
      <ul class="nav__links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/plugins/" class="nav__out">Plugins <span aria-hidden="true">↗</span></a></li>
      </ul>
    </nav>
    <div class="nav__actions">
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" data-theme-toggle>
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></g></svg>
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20.2 14.6A8.4 8.4 0 0 1 9.4 3.8a.6.6 0 0 0-.8-.7A9 9 0 1 0 20.9 15.4a.6.6 0 0 0-.7-.8z" fill="currentColor"/></svg>
      </button>
      <Button size="sm" cta>Message me</Button>
      <button class="nav__menu" type="button" aria-expanded="false" aria-controls="nav-sheet" aria-label="Menu" data-menu>
        <span></span><span></span>
      </button>
    </div>

    <!-- phone menu -->
    <div class="nav__sheet" id="nav-sheet" data-sheet>
      <ul>
        {links.map((l) => <li><a href={l.href} data-sheet-link>{l.label}</a></li>)}
        <li><a href="/plugins/" data-sheet-link class="nav__sheet-out">Plugins</a></li>
      </ul>
    </div>
  </div>
</header>

<style is:global>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 60;
    padding: 14px max(var(--gutter), env(safe-area-inset-right)) 14px max(var(--gutter), env(safe-area-inset-left));
    padding-top: max(14px, env(safe-area-inset-top));
    will-change: transform;
  }
  .nav__inner {
    position: relative;
    max-width: var(--container);
    margin-inline: auto;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    height: 58px;
    padding: 0 8px 0 22px;
    border-radius: var(--r-pill);
  }
  .nav__inner::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    border-radius: inherit;
    background: var(--nav-bg);
    border: 1px solid var(--line);
    box-shadow: 0 10px 40px -10px rgba(30,18,80,.12);
    opacity: 0;
    transform: scale(.98);
    transition: opacity .6s var(--ease), transform .6s var(--ease);
  }
  .nav.is-scrolled .nav__inner::before, .nav.is-open .nav__inner::before { opacity: 1; transform: none; }

  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 680; font-size: 1.06rem; letter-spacing: -0.03em; }
  .brand__mark { flex: none; border-radius: 8px; box-shadow: 0 4px 12px -4px rgba(91,59,242,.55); transition: transform .6s var(--ease); }
  @media (hover: hover) { .brand:hover .brand__mark { transform: rotate(-8deg) scale(1.06); } }

  .nav__links { display: flex; gap: 2px; }
  .nav__links a {
    position: relative; display: block;
    padding: 9px 15px;
    border-radius: var(--r-pill);
    font-size: .925rem; color: var(--ink-2);
    transition: color var(--t) var(--ease), background-color var(--t) var(--ease);
  }
  @media (hover: hover) { .nav__links a:hover { color: var(--ink); background: var(--hover); } }
  .nav__links a.is-active { color: var(--accent-700); background: var(--accent-50); }
  /* the plugin store (tonyjedits.com/plugins): a separate site, so it's quieter, like Portfolio ↗ there */
  .nav__out { color: var(--ink-3) !important; }
  @media (max-width: 960px) and (min-width: 761px) { .nav__links a { padding: 9px 11px; } .nav__out { display: none !important; } }
  .nav__sheet-out { color: var(--ink-3); }

  .nav__actions { display: flex; align-items: center; gap: 6px; }
  .theme-toggle {
    position: relative; display: grid; place-items: center;
    width: 42px; height: 42px; border-radius: 50%;
    color: var(--ink-2);
    transition: background-color .4s var(--ease), color .4s var(--ease), transform .5s var(--ease);
  }
  @media (hover: hover) { .theme-toggle:hover { background: var(--hover); color: var(--ink); } }
  .theme-toggle:active { transform: scale(.92); }
  .theme-toggle svg { grid-area: 1 / 1; transition: opacity .45s var(--ease), transform .6s var(--ease); }
  .theme-toggle__moon { opacity: 0; transform: rotate(-60deg) scale(.6); }
  [data-theme="dark"] .theme-toggle__sun { opacity: 0; transform: rotate(60deg) scale(.6); }
  [data-theme="dark"] .theme-toggle__moon { opacity: 1; transform: none; }
  .nav__menu { display: none; }
  .nav__sheet { display: none; }

  @media (max-width: 760px) {
    .nav__links { display: none; }
    .nav__inner { padding-left: 18px; height: 54px; }
    .nav__menu {
      position: relative; display: grid; place-items: center;
      width: 42px; height: 42px; border-radius: 50%;
      background: var(--bg-2);
    }
    .nav__menu span { position: absolute; left: 13px; right: 13px; height: 1.8px; border-radius: 2px; background: var(--ink); transition: transform .5s var(--ease); }
    .nav__menu span:first-child { transform: translateY(-3.5px); }
    .nav__menu span:last-child { transform: translateY(3.5px); }
    .nav.is-open .nav__menu span:first-child { transform: rotate(45deg); }
    .nav.is-open .nav__menu span:last-child { transform: rotate(-45deg); }

    .nav__sheet {
      display: block;
      position: absolute; left: 0; right: 0; top: calc(100% + 8px);
      padding: 8px;
      border-radius: 24px;
      background: var(--nav-bg);
      border: 1px solid var(--line);
      box-shadow: 0 24px 60px -16px rgba(30,18,80,.28);
      opacity: 0; transform: translateY(-8px) scale(.98); transform-origin: top center;
      pointer-events: none; visibility: hidden;
      transition: opacity .35s var(--ease), transform .5s var(--ease), visibility 0s .5s;
    }
    .nav.is-open .nav__sheet { opacity: 1; transform: none; pointer-events: auto; visibility: visible; transition: opacity .35s var(--ease), transform .5s var(--ease), visibility 0s; }
    .nav__sheet a { display: flex; align-items: center; min-height: 52px; padding: 0 16px; border-radius: 16px; font-size: 1.15rem; font-weight: 600; letter-spacing: -0.02em; }
    .nav__sheet a:active { background: var(--accent-50); color: var(--accent-700); }
  }
  @media (max-width: 760px) { .theme-toggle { width: 38px; height: 38px; } .nav__actions { gap: 4px; } }
  .brand__word { white-space: nowrap; }
  @media (max-width: 760px) { .nav nav { display: none; } }
  @media (max-width: 430px) {
    .nav { padding-left: max(12px, env(safe-area-inset-left)); padding-right: max(12px, env(safe-area-inset-right)); }
    .nav__inner { padding-left: 16px; padding-right: 6px; gap: 8px; }
    .brand { gap: 8px; font-size: 1rem; }
    .nav .btn--sm { padding: 0 13px; font-size: .88rem; }
    .theme-toggle { width: 34px; height: 34px; }
  }
  @media (max-width: 374px) { .brand { font-size: .94rem; } .nav .btn--sm { padding: 0 11px; font-size: .85rem; } }
  /* very narrow phones: the mark stands in for the name, so nothing wraps */
  @media (max-width: 345px) { .brand__word { display: none; } }
</style>
